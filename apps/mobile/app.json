{
  "expo": {
    "name": "DW.ai",
    "slug": "dw-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "dwai",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dimensionalwellness.dwai",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "DW.ai uses the camera to let you document your wellness journey.",
        "NSPhotoLibraryUsageDescription": "DW.ai accesses your photo library to let you add wellness images.",
        "NSMicrophoneUsageDescription": "DW.ai uses the microphone for voice mode and audio journaling.",
        "NSFaceIDUsageDescription": "Use Face ID to securely access your DW.ai account.",
        "ITSAppUsesNonExemptEncryption": false,
        "SKAdNetworkItems": []
      },
      "associatedDomains": ["applinks:dimensionalwellnessai.com"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.dimensionalwellness.dwai"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io",
          "project": "dw-ai-mobile",
          "organization": "dimensional-wellness"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      },
      "revenueCatApiKeyIos": "appl_YOUR_REVENUECAT_IOS_KEY",
      "revenueCatApiKeyAndroid": "goog_YOUR_REVENUECAT_ANDROID_KEY",
      "sentryDsn": "YOUR_SENTRY_DSN",
      "posthogApiKey": "YOUR_POSTHOG_API_KEY"
    },
    "owner": "dimensional-wellness"
  }
}
