# DW.ai Mobile App Environment Variables
# Copy to .env.local and fill in values

# ─── API ──────────────────────────────────────────────────────────────────────
# Override the API base URL (optional: set in src/config/env.ts per environment)
# EXPO_PUBLIC_API_BASE_URL=https://dimensionalwellnessai.com

# ─── RevenueCat (Subscriptions) ────────────────────────────────────────────────
# Get keys from https://app.revenuecat.com
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_YOUR_KEY_HERE
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_YOUR_KEY_HERE

# ─── Sentry (Error Monitoring) ────────────────────────────────────────────────
# Get DSN from https://sentry.io > Project Settings > Client Keys
EXPO_PUBLIC_SENTRY_DSN=https://YOUR_KEY@sentry.io/YOUR_PROJECT_ID

# ─── Analytics (PostHog) ──────────────────────────────────────────────────────
# Get key from https://app.posthog.com > Project Settings
EXPO_PUBLIC_POSTHOG_API_KEY=phc_YOUR_KEY_HERE

# ─── EAS Build ────────────────────────────────────────────────────────────────
# These are set in eas.json, but can be overridden here for local testing
# APP_ENV=development|staging|production
