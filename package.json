  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/index.ts",
    "build": "tsx script/build.ts",
    "start": "NODE_ENV=production node dist/index.cjs",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "seed:demo": "tsx server/seed-demo.ts",
    "seed:qa": "tsx server/seed-qa.ts",
    "seed:test": "tsx script/seed-test-data.ts",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "test:ui": "vitest --ui",
    "sync:ios": "npm run build && npx cap sync ios",
    "sync:android": "npm run build && npx cap sync android",
    "ios": "npm run sync:ios && npx cap open ios",
    "android": "npm run sync:android && npx cap open android",
    "build:ios": "npm run sync:ios && cd ios && xcodebuild -workspace App/App.xcworkspace -scheme App -configuration Release archive -archivePath App.xcarchive",
    "build:android": "npm run sync:android && cd android && ./gradlew assembleRelease bundleRelease",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "prepare": "husky"
  },
