# ─── Required ─────────────────────────────────────────────────────────────────
# Strong random secret for session signing (min 64 chars recommended)
SESSION_SECRET=<strong-random-secret-min-64-chars>

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/fts

# ─── Plaid (Financial Integration) ────────────────────────────────────────────
# IMPORTANT: Set PLAID_ENCRYPTION_KEY independently of SESSION_SECRET.
# Using the same value for both means a single leaked secret compromises
# both session integrity AND encrypted financial data.
PLAID_ENCRYPTION_KEY=<separate-strong-random-secret>
PLAID_CLIENT_ID=
PLAID_SECRET=
# "sandbox" | "development" | "production"
PLAID_ENV=sandbox

# ─── AI Integration (OpenAI-compatible API) ────────────────────────────────────
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=your-openai-api-key

# Optional: main DW chat model/provider override (Phase 3)
# - DW_AI_MODEL_CHAT controls the model for main coaching chat routes.
# - DW_AI_CHAT_BASE_URL + DW_AI_CHAT_API_KEY can point chat to an OpenAI-compatible
#   proxy/provider endpoint (e.g. OpenRouter) without changing other AI call sites.
DW_AI_MODEL_CHAT=
DW_AI_CHAT_BASE_URL=
DW_AI_CHAT_API_KEY=

# ─── Email (Resend) ────────────────────────────────────────────────────────────
# Required for password reset functionality
# Get your API key at https://resend.com
RESEND_API_KEY=
# Must be a valid "from" value supported by Resend
# e.g. DW.ai <no-reply@your-verified-domain.com>
RESEND_FROM_EMAIL=no-reply@your-verified-domain.com

# ─── App URL ───────────────────────────────────────────────────────────────────
# The public URL of your app, used in password reset email links and OAuth redirect URIs
APP_URL=https://dimensionalwellnessai.com

# ─── OAuth (Social Sign-In) ────────────────────────────────────────────────────
# Base URL used to build OAuth callback/redirect URIs.
# Defaults to APP_URL if not set.
OAUTH_REDIRECT_BASE_URL=https://dimensionalwellnessai.com

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Create an "OAuth 2.0 Client ID" (Web application) and add the callback URI:
#   https://dimensionalwellnessai.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth — https://developers.facebook.com/apps
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Apple Sign In — https://developer.apple.com/account/resources/identifiers
APPLE_CLIENT_ID=com.example.yourapp
APPLE_TEAM_ID=ABCDE12345
APPLE_KEY_ID=XXXXXXXXXX
# Multi-line PEM — paste the full contents of your .p8 file, replacing real newlines with \n:
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----

# ─── Payments (Stripe) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Push Notifications (Web Push / VAPID) ────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── Wearables (Whoop / Oura / Garmin) ────────────────────────────────────────
# OAuth callback URL pattern: ${OAUTH_REDIRECT_BASE_URL}/api/wearables/<source>/callback

# Whoop Developer Dashboard: https://developer.whoop.com
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Oura Cloud Application: https://cloud.ouraring.com/oauth/applications
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# Garmin Connect Developer Program (Wellness/Health API, OAuth 1.0a)
GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=

# ─── External Content Discovery APIs (Optional) ───────────────────────────────
# YouTube Data API v3 — https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# NewsAPI — https://newsapi.org/
NEWS_API_KEY=

# API-Ninjas Exercise Database — https://api-ninjas.com/
EXERCISE_API_KEY=
