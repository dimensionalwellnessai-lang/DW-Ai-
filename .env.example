# Database
DATABASE_URL=postgresql://user:password@localhost:5432/fts

# Session
SESSION_SECRET=your-session-secret-here

# AI Integration (OpenAI-compatible API)
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=your-openai-api-key

# External Content Discovery APIs (Optional)
# YouTube Data API v3 - https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# NewsAPI - https://newsapi.org/
NEWS_API_KEY=

# API-Ninjas Exercise Database - https://api-ninjas.com/
EXERCISE_API_KEY=

# Resend (Email) - Required for password reset functionality
# Option 1: Set RESEND_API_KEY directly (works on any platform)
# Get your API key at https://resend.com
RESEND_API_KEY=
# Must be a valid "from" value supported by Resend, e.g. DW.ai <no-reply@your-verified-domain.com>.
# Replace "your-verified-domain.com" with a domain you have verified in your Resend dashboard.
RESEND_FROM_EMAIL=no-reply@your-verified-domain.com

# The public URL of your app, used in password reset email links
APP_URL=https://yourdomain.com
